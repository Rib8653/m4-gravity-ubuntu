# The finished kernel config must contain every line below exactly.
# These are the options the M4 Mac mini (t8132 / j773g) needs to boot and
# show graphics, and the speaker protection that Gravity checks in its image
# build (kiwi-descriptions/config.sh).
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARCH_APPLE=y
CONFIG_RUST=y
CONFIG_DRM_ASAHI_M4=m
CONFIG_SND_SOC_APPLE_T8132_SPEAKER=y
CONFIG_SND_SOC_TAS2764=y
CONFIG_SND_SOC_APPLE_MCA=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SQUASHFS=y
CONFIG_EFI=y
