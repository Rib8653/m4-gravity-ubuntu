# Ubuntu-specific overlay, applied after Gravity's fragments
# (gravity-aarch64.config, gravity.config and gravity-trim.config) on top of
# the Asahi Fedora 16K base config. Use CONFIG_X=n to disable an option.

# Ubuntu confines its applications with AppArmor, where Fedora uses SELinux.
# SELinux stays built in but is not in the default LSM list.
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"

# Fedora's keyrings are not available here. Modules are signed with a key
# generated at build time.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"

# Ubuntu's kmod and initramfs-tools handle zstd-compressed modules.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# Snaps (Firefox, etc.) need squashfs with these decompressors.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZO=y

# Default local version is set by the build script (KERNEL_LOCALVERSION).
CONFIG_LOCALVERSION=""
CONFIG_LOCALVERSION_AUTO=n
