# shellcheck shell=sh
# Pinned inputs for the Ubuntu build of Gravity Linux.
#
# These pins come from the GravityLinux/packages repository's sources.json, so
# Ubuntu builds the same kernel, Mesa, bootloader, U-Boot patch set, scripts
# and firmware tooling as Gravity's Fedora 44 image. When you move to a newer
# Gravity release, update GRAVITY_PACKAGES_REF first, then copy the matching
# refs from its sources.json.
#
# Each value can be overridden from the environment, e.g.
#   LINUX_REF=<sha> make kernel

# ---------------------------------------------------------------- Ubuntu base
: "${UBUNTU_SUITE:=resolute}"          # Ubuntu 26.04 LTS
: "${UBUNTU_RELEASE:=26.04}"
: "${UBUNTU_MIRROR:=http://ports.ubuntu.com/ubuntu-ports}"
: "${UBUNTU_COMPONENTS:=main restricted universe multiverse}"

# ------------------------------------------------------- Gravity packaging repo
# Supplies the kernel config fragments and export patches, the U-Boot patch
# stack, the m1n1 display patch and the first-boot/sleep-policy files.
: "${GRAVITY_PACKAGES_URL:=https://github.com/GravityLinux/packages.git}"
: "${GRAVITY_PACKAGES_REF:=711c2a110416d28010ccdd118b83111776bff207}"

# --------------------------------------------------------------------- Kernel
: "${LINUX_URL:=https://github.com/GravityLinux/linux.git}"
: "${LINUX_REF:=dea38a96aa86679d5e24da16b799030fe07ad2f6}"
: "${LINUX_VERSION:=7.1.13}"
# Debian revision of the kernel packages. Gravity's Fedora release is 509.
: "${KERNEL_DEB_REVISION:=509gravity1}"
: "${KERNEL_LOCALVERSION:=-gravity-16k}"
# Gravity derives its 16K config from this Asahi Fedora SRPM, and so do we.
: "${KERNEL_BASE_SRPM_URL:=https://download.copr.fedorainfracloud.org/results/@asahi/kernel/srpm-builds/10979408/kernel-7.1.13-403.asahi.fc44.src.rpm}"
: "${KERNEL_BASE_SRPM_SHA256:=b21403621e44d6390c089126afb2c8ee41a9926b4bd7a840b544b39ffd15be9a}"
: "${KERNEL_BASE_CONFIG_NAME:=kernel-aarch64-16k-fedora.config}"
# COPR prunes old builds, so the SRPM above can disappear (it now returns 404).
# Then the build falls back to Asahi Linux's own 16K kernel config, pinned by
# commit and checksum. The M4 build was tested with this config.
: "${KERNEL_FALLBACK_CONFIG_URL:=https://raw.githubusercontent.com/AsahiLinux/PKGBUILDs/554db4d8ca17fbcda6f3d6d8fb2f1cf9a90a36a0/linux-asahi/config}"
: "${KERNEL_FALLBACK_CONFIG_SHA256:=653ac121b5a3a34356f10cc0c4aa3286f4e9be4a5927a5267efec0f3f38c1f41}"

# ----------------------------------------------------------------------- Mesa
: "${MESA_URL:=https://github.com/GravityLinux/mesa.git}"
: "${MESA_REF:=87ac51d411f0e58a9433567ec2666f457be89e1d}"
: "${MESA_UPSTREAM_VERSION:=26.3.0~devel}"
: "${MESA_DEB_REVISION:=0gravity1}"

# ------------------------------------------------------------ m1n1 bootloader
: "${BOOTLOADER_URL:=https://github.com/GravityLinux/bootloader.git}"
: "${BOOTLOADER_REF:=f64760b501214c749788f89620c078d8b39b0453}"
: "${BOOTLOADER_VERSION:=1.6.1}"
: "${BOOTLOADER_DEB_REVISION:=110gravity1}"
: "${ARTWORK_URL:=https://github.com/GravityLinux/artwork.git}"
: "${ARTWORK_REF:=e613a87e526f8fec439c4129e69dd2821b38d258}"

# --------------------------------------------------------------------- U-Boot
: "${UBOOT_VERSION:=2026.07}"
: "${UBOOT_TARBALL_URL:=https://ftp.denx.de/pub/u-boot/u-boot-${UBOOT_VERSION}.tar.bz2}"
: "${UBOOT_TARBALL_SHA256:=78e8bfc382fe388f9b55aa1daf8c563522a037779b5d4c349d1415e381f1243e}"
# Used only if the denx.de tarball cannot be downloaded. The tag holds the same tree.
: "${UBOOT_GIT_URL:=https://github.com/u-boot/u-boot.git}"
: "${UBOOT_GIT_REF:=v${UBOOT_VERSION}}"
: "${UBOOT_DEB_REVISION:=200gravity1}"

# ------------------------------------------------- Gravity scripts / installer
: "${SCRIPTS_URL:=https://github.com/GravityLinux/scripts.git}"
: "${SCRIPTS_REF:=12418e50125a72749a75917db578db55ea42704c}"
: "${INSTALLER_URL:=https://github.com/GravityLinux/installer.git}"
: "${INSTALLER_REF:=34c9ded9e2e4efd9add6bb984d5c50656ea324da}"

# ------------------------------------------------------------- Audio (UCM)
# Fedora gets this as alsa-ucm-asahi. Ubuntu has no package for it.
: "${ALSA_UCM_ASAHI_URL:=https://github.com/AsahiLinux/alsa-ucm-conf-asahi.git}"
: "${ALSA_UCM_ASAHI_REF:=1473329acab595dfef039f38c384ce16674d6b15}"  # tag v10
: "${ALSA_UCM_ASAHI_VERSION:=10}"

# Version of the Ubuntu-specific glue packages built from this repository.
: "${PLATFORM_VERSION:=0.1.0}"
